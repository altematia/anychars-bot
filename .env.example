SESSION_STRING=your_telethon_string_session
API_ID=2040
API_HASH=your_api_hash
SELF_ID=your_telegram_user_id
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
HISTORY_LIMIT=20
MEMORY_LIMIT=15
# Спонтанные сообщения Аме-чан
SPONTANEOUS_MIN=40
SPONTANEOUS_MAX=110
SPONTANEOUS_CHANCE=0.55
LAST_SEEN_WINDOW_H=30
# ===== Style rotation =====
STYLE_SWITCH_MIN=3
STYLE_SWITCH_MAX=6
# ===== Voice (TTS) =====
TTS_ENABLED=1
TTS_CHANCE=0.35
TTS_VOICE=nova
# ===== PC tools =====
# Аме-чан может выполнять whitelist-команды на компьютере:
# pc_status, open_app, open_url, screenshot, set_volume, get_volume, battery, say_text
# (прописаны в pc_tools.py, опасных команд нет)
# необязательно, если Telegram API блокируется (через TOR):
TELEGRAM_PROXY_URL=socks5://127.0.0.1:9050
OPENAI_PROXY_URL=socks5://127.0.0.1:9050